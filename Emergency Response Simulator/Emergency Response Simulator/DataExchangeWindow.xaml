<Window x:Class="Emergency_Response_Simulator.DataExchangeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Data Standards &amp; NIMS" Width="1180" Height="800" MinWidth="900" MinHeight="560"
        Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextBrush}" FontSize="12"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style x:Key="Header" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
            <Setter Property="Margin" Value="0,8,0,2" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="Margin" Value="0,0,4,4" />
        </Style>
    </Window.Resources>
    <TabControl Margin="12" Background="{DynamicResource PanelBrush}">

        <!-- Exchange: CAP, EDXL, NIEM, HL7 out and in -->
        <TabItem Header="Exchange">
            <DockPanel Margin="8">
                <TextBlock DockPanel.Dock="Bottom" Text="{Binding Status}" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,6,0,0" />
                <StackPanel DockPanel.Dock="Left" Width="300" Margin="0,0,12,0">
                    <TextBlock Text="STANDARD" Style="{StaticResource Header}" Margin="0,0,0,2" />
                    <ComboBox ItemsSource="{Binding Standards}" SelectedItem="{Binding SelectedStandard}" DisplayMemberPath="Label" />
                    <TextBlock Text="{Binding StandardDescription}" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" Margin="0,4,0,0" />
                    <TextBlock Text="INCIDENT" Style="{StaticResource Header}" />
                    <ComboBox ItemsSource="{Binding Incidents}" SelectedItem="{Binding SelectedIncident}" DisplayMemberPath="Label" />
                    <TextBlock Text="OUT" Style="{StaticResource Header}" Margin="0,12,0,2" />
                    <WrapPanel>
                        <Button Content="Export" Command="{Binding ExportCommand}"
                                ToolTip="The picture in this standard: what command knows, never the ground truth" />
                        <Button Content="Save…" Command="{Binding SaveCommand}" />
                    </WrapPanel>
                    <TextBlock Text="IN" Style="{StaticResource Header}" Margin="0,12,0,2" />
                    <WrapPanel>
                        <Button Content="Open file and import…" Command="{Binding ImportFileCommand}"
                                ToolTip="A document from another system, as the standard selected above" />
                        <Button Content="Import the text" Command="{Binding ImportTextCommand}"
                                ToolTip="Takes in what is pasted in the document box, as the standard selected above" />
                    </WrapPanel>
                    <TextBlock Text="Imports arrive as information received: a report, an alert, a hospital's status or a patient's move. Over the network only the instructor can import."
                               TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" Margin="0,4,0,0" />
                    <TextBlock Text="WHAT WAS TAKEN IN" Style="{StaticResource Header}" Margin="0,12,0,2" />
                    <ListBox ItemsSource="{Binding ImportNotes}" Height="220" Background="{DynamicResource PanelBrush}" Foreground="{DynamicResource TextBrush}"
                             BorderBrush="{DynamicResource BorderBrush}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" TextWrapping="Wrap" Width="270" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="DOCUMENT" Style="{StaticResource Header}" Margin="0,0,0,2" />
                    <TextBox Text="{Binding Document, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" AcceptsTab="True"
                             FontFamily="Consolas" FontSize="11" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                             TextWrapping="NoWrap" />
                </DockPanel>
            </DockPanel>
        </TabItem>

        <!-- NIMS/ICS compliance -->
        <TabItem Header="NIMS/ICS compliance">
            <DockPanel Margin="8">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="INCIDENT" Style="{StaticResource Header}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ComboBox ItemsSource="{Binding Incidents}" SelectedItem="{Binding SelectedIncident}" DisplayMemberPath="Label" Width="260" Margin="0,0,8,0" />
                    <Button Content="Check" Command="{Binding CheckNimsCommand}" Margin="0"
                            ToolTip="Command, span of control, unified command, facilities, the IAP and its forms, plain language and resource typing" />
                    <TextBlock Text="{Binding NimsSummary}" VerticalAlignment="Center" Margin="12,0,0,0" FontWeight="SemiBold" />
                </StackPanel>
                <DataGrid ItemsSource="{Binding NimsFindings}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Area" Binding="{Binding Area}" Width="120" />
                        <DataGridTextColumn Header="" Binding="{Binding Severity}" Width="80" />
                        <DataGridTextColumn Header="Finding" Binding="{Binding Message}" Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Reference" Binding="{Binding Reference}" Width="300" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </TabItem>

        <!-- Terminology -->
        <TabItem Header="NIMS terminology">
            <Grid Margin="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="460" />
                </Grid.ColumnDefinitions>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="LOCAL TERMS AND NIMS" Style="{StaticResource Header}" Margin="0,0,0,2" />
                    <DataGrid ItemsSource="{Binding Crosswalk}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Here" Binding="{Binding Local}" Width="180" />
                            <DataGridTextColumn Header="NIMS" Binding="{Binding Nims}" Width="220" />
                            <DataGridTextColumn Header="" Binding="{Binding Note}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
                <DockPanel Grid.Column="2">
                    <TextBlock DockPanel.Dock="Top" Text="COMMAND AND GENERAL STAFF" Style="{StaticResource Header}" Margin="0,0,0,2" />
                    <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Positions}" Margin="0,0,0,8" />
                    <TextBlock DockPanel.Dock="Top" Text="RESOURCE TYPING" Style="{StaticResource Header}" />
                    <DataGrid ItemsSource="{Binding ResourceTypes}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="130" />
                            <DataGridTextColumn Header="NIMS kind, type" Binding="{Binding Nims}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Grid>
        </TabItem>
    </TabControl>
</Window>
