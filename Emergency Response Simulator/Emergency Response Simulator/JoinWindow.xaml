<Window x:Class="Emergency_Response_Simulator.JoinWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Join a simulation session" Width="460" SizeToContent="Height" WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource TextBrush}">
    <StackPanel Margin="16">
        <TextBlock Text="EMERGENCY RESPONSE SIMULATOR" Style="{StaticResource PanelHeader}" />
        <TextBlock Text="Server" Margin="0,4,0,2" />
        <TextBox x:Name="ServerBox" ToolTip="The simulation server's address, e.g. http://training-pc:5180" />
        <TextBlock Text="Your name" Margin="0,8,0,2" />
        <TextBox x:Name="NameBox" MaxLength="40" />

        <TabControl x:Name="Mode" Margin="0,12,0,0">
            <TabItem Header="Join a session">
                <StackPanel Margin="8">
                    <TextBlock Text="Join code (from your instructor)" Margin="0,0,0,2" />
                    <TextBox x:Name="CodeBox" CharacterCasing="Upper" MaxLength="6" FontFamily="Consolas" FontSize="16" />
                    <TextBlock Text="Role" Margin="0,8,0,2" />
                    <ComboBox x:Name="RoleBox" SelectionChanged="OnRoleChanged" />
                    <StackPanel x:Name="JoinPinPanel" Visibility="Collapsed">
                        <TextBlock Text="Instructor PIN" Margin="0,8,0,2" />
                        <PasswordBox x:Name="JoinPinBox" />
                    </StackPanel>
                </StackPanel>
            </TabItem>
            <TabItem Header="Open a session (instructor)">
                <StackPanel Margin="8">
                    <TextBlock Text="Scenario" Margin="0,0,0,2" />
                    <ComboBox x:Name="ScenarioBox" DisplayMemberPath="Name" SelectionChanged="OnScenarioChanged" />
                    <TextBlock x:Name="ScenarioText" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource MutedTextBrush}" Margin="0,2,0,0" />
                    <TextBlock Text="Title" Margin="0,8,0,2" />
                    <TextBox x:Name="TitleBox" ToolTip="Shown to everyone who joins, e.g. 'Blue watch, 11 October'" />
                    <TextBlock Text="Instructor PIN" Margin="0,8,0,2" />
                    <PasswordBox x:Name="CreatePinBox" />
                </StackPanel>
            </TabItem>
        </TabControl>

        <TextBlock x:Name="ErrorText" Foreground="{StaticResource CriticalBrush}" TextWrapping="Wrap" Margin="0,8,0,0" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="GoButton" Content="Join" Padding="16,4" IsDefault="True" Click="OnGo" />
            <Button Content="Cancel" Padding="16,4" Margin="8,0,0,0" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
