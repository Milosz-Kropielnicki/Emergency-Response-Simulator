<Window x:Class="Emergency_Response_Simulator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Emergency_Response_Simulator.ViewModels"
        xmlns:mapsui="clr-namespace:Mapsui.UI.Wpf;assembly=Mapsui.UI.Wpf"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="Emergency Response Simulator" Height="900" Width="1500" MinHeight="600" MinWidth="1000"
        WindowState="Maximized"
        Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" FontSize="13" PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <!-- Time · title · detail row used by the incident, alert and comms feeds. -->
        <DataTemplate x:Key="FeedItemTemplate" DataType="{x:Type vm:FeedItem}">
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="44" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Time}" Foreground="{StaticResource MutedTextBrush}" FontFamily="Consolas" />
                <StackPanel Grid.Column="1">
                    <TextBlock x:Name="Title" Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Detail}" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Severity}" Value="Critical">
                    <Setter TargetName="Title" Property="Foreground" Value="{StaticResource CriticalBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="Warning">
                    <Setter TargetName="Title" Property="Foreground" Value="{StaticResource WarningBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="High">
                    <Setter TargetName="Title" Property="Foreground" Value="{StaticResource WarningBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- A unit with a drop-down to move it between ICS groups. -->
        <DataTemplate x:Key="UnitPlacementTemplate" DataType="{x:Type vm:UnitPlacementRow}">
            <DockPanel Margin="0,1">
                <ComboBox DockPanel.Dock="Right" ItemsSource="{Binding Options}" SelectedItem="{Binding Placement}"
                          DisplayMemberPath="Name" Width="140" FontSize="11" />
                <TextBlock VerticalAlignment="Center">
                    <Run Text="{Binding Callsign, Mode=OneWay}" />
                    <Run Text="{Binding Status, Mode=OneWay}" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                </TextBlock>
            </DockPanel>
        </DataTemplate>

        <Style x:Key="EmptyHint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="FontStyle" Value="Italic" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="200" />
            <RowDefinition Height="5" />
            <RowDefinition Height="320" MinHeight="120" />
        </Grid.RowDefinitions>

        <!-- ===== Header: incident, clock, simulation controls ===== -->
        <Border Grid.Row="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1" Padding="12,8">
            <DockPanel LastChildFill="True">
                <ToggleButton DockPanel.Dock="Left" Content="☰ Layers" ToolTip="Show or hide map layers"
                              IsChecked="{Binding IsLeftPanelOpen}" Margin="0,0,12,0" />

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding CommandMessage}" VerticalAlignment="Center" Margin="0,0,16,0"
                               MaxWidth="420" TextTrimming="CharacterEllipsis">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource OkBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CommandFailed}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource CriticalBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding EventStoreLabel}" Foreground="{StaticResource MutedTextBrush}"
                               VerticalAlignment="Center" Margin="0,0,16,0" />
                    <Button Command="{Binding TogglePlayCommand}" MinWidth="80" ToolTip="Start or pause the simulation">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ToolbarButton}">
                                <Setter Property="Content" Value="▶ Start" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                        <Setter Property="Content" Value="⏸ Pause" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <ItemsControl ItemsSource="{Binding TimeScales}" VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding}" ContentStringFormat="{}{0}×" Margin="2,0" Padding="8,4"
                                        Command="{Binding DataContext.SetTimeScaleCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}" ToolTip="Simulation speed" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Margin="16,0,16,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding SimClock}" FontFamily="Consolas" FontSize="22" FontWeight="SemiBold"
                                   HorizontalAlignment="Right" />
                        <TextBlock HorizontalAlignment="Right" Foreground="{StaticResource MutedTextBrush}" FontSize="11">
                            <Run Text="{Binding SimDate, Mode=OneWay}" />
                            <Run Text="·" />
                            <Run Text="{Binding TimeScale, Mode=OneWay, StringFormat={}{0}×}" />
                        </TextBlock>
                    </StackPanel>
                    <ToggleButton Content="Comms / Incident ☰" ToolTip="Show or hide the communications hub and incident detail"
                                  IsChecked="{Binding IsRightPanelOpen}" />
                </StackPanel>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding IncidentTitle}" FontSize="17" FontWeight="Bold" />
                    <TextBlock Text="{Binding IncidentSubtitle}" Foreground="{StaticResource MutedTextBrush}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===== Replay banner (the COP is showing the past) ===== -->
        <Border Grid.Row="1" Background="#7A1F1F" Padding="12,5"
                Visibility="{Binding Timeline.IsReplay, Converter={StaticResource BoolToVisibility}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Return to live" Command="{Binding Timeline.ReturnToLiveCommand}" />
                <TextBlock Text="{Binding Timeline.ReplayLabel}" FontWeight="SemiBold" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <!-- ===== Map with left / right / top pop-out panels ===== -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Left: map icon / layer toggles -->
            <Border Grid.Column="0" Width="250" Style="{StaticResource Panel}" BorderThickness="0,0,1,0"
                    Visibility="{Binding IsLeftPanelOpen, Converter={StaticResource BoolToVisibility}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding LayerGroups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:LayerGroup}">
                                    <StackPanel Margin="0,0,0,12">
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource PanelHeader}" Margin="0,0,0,4" />
                                        <ItemsControl ItemsSource="{Binding Items}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:ToggleItem}">
                                                    <DockPanel>
                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Detail}" FontSize="11"
                                                                   Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
                                                        <CheckBox Content="{Binding Label}" IsChecked="{Binding IsOn}"
                                                                  IsEnabled="{Binding IsAvailable}" />
                                                    </DockPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="ACTIVE ZONES" Style="{StaticResource PanelHeader}" Margin="0,0,0,4" />
                        <TextBlock Style="{StaticResource EmptyHint}" Text="None. Use Draw zone on the map.">
                            <TextBlock.Visibility>
                                <Binding Path="ActiveZones.Count" Converter="{x:Static vm:Converters.ZeroToVisible}" />
                            </TextBlock.Visibility>
                        </TextBlock>
                        <ItemsControl ItemsSource="{Binding ActiveZones}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ActiveZoneItem}">
                                    <DockPanel Margin="0,2">
                                        <Button DockPanel.Dock="Right" Content="Lift" Padding="6,1" FontSize="11"
                                                ToolTip="Lift this zone (recorded as a C2 order)"
                                                Command="{Binding DataContext.LiftZoneCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding Id}" />
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Type}" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Centre: the map -->
            <Grid Grid.Column="1" ClipToBounds="True">
                <mapsui:MapControl x:Name="MapView" />

                <!-- Reported wind (what command has been told, not ground truth). -->
                <Border VerticalAlignment="Top" HorizontalAlignment="Left" Margin="10" Padding="10,5"
                        Background="#DD161D26" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4">
                    <TextBlock Text="{Binding WeatherSummary}" FontSize="12" />
                </Border>

                <!-- Zone drawing tool (dynamic GIS objects). -->
                <Border VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="10,10,10,28" Padding="10,8" MaxWidth="560"
                        Background="#EE161D26" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4"
                        DataContext="{Binding ZoneDrawing}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <ComboBox ItemsSource="{Binding ZoneTypes}" SelectedItem="{Binding SelectedType}"
                                      DisplayMemberPath="Label" Width="190" Margin="0,0,6,0" />
                            <Button Content="&#x270E; Draw zone" Command="{Binding StartCommand}" />
                            <Button Content="Finish" Command="{Binding FinishCommand}"
                                    Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}" />
                            <Button Content="Cancel" Command="{Binding CancelCommand}"
                                    Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                        <TextBlock Text="{Binding Hint}" Foreground="{StaticResource MutedTextBrush}" FontSize="11"
                                   TextWrapping="Wrap" Margin="0,6,0,0" />
                        <TextBlock Text="{Binding Error}" Foreground="{StaticResource CriticalBrush}" FontSize="11" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- Details of the clicked feature or location. -->
                <Border VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="10,10,10,28" Padding="12,8" Width="330"
                        Background="#EE161D26" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="4"
                        Visibility="{Binding IsInfoOpen, Converter={StaticResource BoolToVisibility}}">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top">
                            <Button DockPanel.Dock="Right" Content="&#x2715;" Padding="6,0" Margin="0" Command="{Binding CloseInfoCommand}" />
                            <TextBlock Text="{Binding InfoTitle}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,8,6" />
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding InfoLines}" MaxHeight="220">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
                </Border>

                <!-- Hovering the top edge reveals the map-view panel. -->
                <Border x:Name="TopHoverStrip" VerticalAlignment="Top" HorizontalAlignment="Center"
                        Background="#CC161D26" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,1,1"
                        CornerRadius="0,0,4,4" Padding="14,2" MouseEnter="TopHoverStrip_MouseEnter">
                    <TextBlock Text="▾ Map views" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                </Border>

                <Border x:Name="TopPanel" VerticalAlignment="Top" HorizontalAlignment="Center"
                        Style="{StaticResource Panel}" BorderThickness="1,0,1,1" CornerRadius="0,0,6,6"
                        Background="#EE161D26" MouseLeave="TopPanel_MouseLeave"
                        Visibility="{Binding IsTopPanelOpen, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="MAP VIEW" Style="{StaticResource PanelHeader}" />
                        <StackPanel Orientation="Horizontal">
                            <ItemsControl ItemsSource="{Binding MapViews}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:ToggleItem}">
                                        <RadioButton GroupName="MapView" Content="{Binding Label}" IsChecked="{Binding IsOn}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Rectangle Width="1" Fill="{StaticResource BorderBrush}" Margin="4,0,14,0" />
                            <CheckBox Content="{Binding AreaCodes.Label}" IsChecked="{Binding AreaCodes.IsOn}" Margin="0" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Right: communications hub and incident detail -->
            <Border Grid.Column="2" Width="360" Style="{StaticResource Panel}" BorderThickness="1,0,0,0" Padding="8"
                    Visibility="{Binding IsRightPanelOpen, Converter={StaticResource BoolToVisibility}}">
                <TabControl SelectedIndex="{Binding RightPanelTab}">
                    <TabItem Header="COMMS HUB">
                        <DockPanel>
                    
                            <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding CommsChannels}" Margin="0,0,0,8">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:ToggleItem}">
                                        <ToggleButton Content="{Binding Label}" IsChecked="{Binding IsOn}"
                                                      Margin="0,0,4,4" Padding="8,3" FontSize="12" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Rectangle DockPanel.Dock="Top" Height="1" Fill="{StaticResource BorderBrush}" Margin="0,0,0,8" />
                            <Grid>
                                <ListBox ItemsSource="{Binding CommsFeed}" ItemTemplate="{StaticResource FeedItemTemplate}" />
                                <TextBlock Style="{StaticResource EmptyHint}"
                                           Text="No traffic yet. Calls, field reports and radio will appear here.">
                                    <TextBlock.Visibility>
                                        <Binding Path="CommsFeed.Count" Converter="{x:Static vm:Converters.ZeroToVisible}" />
                                    </TextBlock.Visibility>
                                </TextBlock>
                            </Grid>
                        </DockPanel>
                    </TabItem>
                    <TabItem Header="INCIDENT">
                        <Grid DataContext="{Binding IncidentDetail}">
                            <TextBlock Style="{StaticResource EmptyHint}" Margin="4,8"
                                       Text="Select an incident on the board or the map, or open one from a report in the intelligence feed."
                                       Visibility="{Binding HasIncident, Converter={x:Static vm:Converters.FalseToVisible}}" />
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          Visibility="{Binding HasIncident, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel Margin="4">
                                    <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="Bold" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Summary}" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,2,0,10" />

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                            <RowDefinition /><RowDefinition /><RowDefinition />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Text="Priority" Style="{StaticResource FieldLabel}" />
                                        <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding Priorities}" SelectedItem="{Binding Priority}" Margin="0,2" />
                                        <TextBlock Grid.Row="1" Text="Status" Style="{StaticResource FieldLabel}" />
                                        <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Statuses}" SelectedItem="{Binding Status}" Margin="0,2" />
                                        <TextBlock Grid.Row="2" Text="Casualties reported" Style="{StaticResource FieldLabel}" />
                                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding CasualtiesReported, UpdateSourceTrigger=PropertyChanged}" Margin="0,2" />
                                        <TextBlock Grid.Row="3" Text="Casualties confirmed" Style="{StaticResource FieldLabel}" />
                                        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding CasualtiesConfirmed, UpdateSourceTrigger=PropertyChanged}" Margin="0,2" />
                                        <TextBlock Grid.Row="4" Text="Threats" Style="{StaticResource FieldLabel}" />
                                        <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Threats, UpdateSourceTrigger=PropertyChanged}" Margin="0,2"
                                                 ToolTip="Comma-separated, e.g. Fire, Smoke, Possible chemical storage" />
                                        <TextBlock Grid.Row="5" Text="Incident commander" Style="{StaticResource FieldLabel}" />
                                        <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding Commander, UpdateSourceTrigger=PropertyChanged}" Margin="0,2" />
                                        <CheckBox Grid.Row="6" Grid.Column="1" Content="Evacuation required" IsChecked="{Binding EvacuationRequired}" />
                                    </Grid>
                                    <Button Content="Apply changes" Command="{Binding ApplyCommand}" HorizontalAlignment="Left" Margin="0,8,0,12" />

                                    <TextBlock Text="OPERATIONAL BOUNDARIES" Style="{StaticResource PanelHeader}" />
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="Hot" Style="{StaticResource FieldLabel}" Margin="0,0,4,0" />
                                        <TextBox Text="{Binding HotRadius}" Width="44" />
                                        <TextBlock Text="Warm" Style="{StaticResource FieldLabel}" Margin="8,0,4,0" />
                                        <TextBox Text="{Binding WarmRadius}" Width="44" />
                                        <TextBlock Text="Cold" Style="{StaticResource FieldLabel}" Margin="8,0,4,0" />
                                        <TextBox Text="{Binding ColdRadius}" Width="44" />
                                        <TextBlock Text="m" Style="{StaticResource FieldLabel}" Margin="4,0,0,0" />
                                    </StackPanel>
                                    <Button Content="Establish hot / warm / cold zones here" Command="{Binding EstablishHazardZonesCommand}"
                                            HorizontalAlignment="Left" Margin="0,0,0,4" />
                                    <TextBlock Style="{StaticResource EmptyHint}" FontSize="11" Margin="0,0,0,12"
                                               Text="Command posts, staging areas, evacuation zones: use Draw zone on the map; they attach to this incident." />

                                    <DockPanel Margin="0,0,0,4">
                                        <Button DockPanel.Dock="Right" Content="↻" Padding="6,0" Margin="0" Command="{Binding RankCommand}"
                                                ToolTip="Recalculate road ETAs" />
                                        <TextBlock Text="CLOSEST AVAILABLE UNITS (BY ROAD)" Style="{StaticResource PanelHeader}" Margin="0" />
                                    </DockPanel>
                                    <ItemsControl ItemsSource="{Binding Candidates}" Margin="0,0,0,2">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:UnitCandidate}">
                                                <DockPanel Margin="0,1">
                                                    <Button DockPanel.Dock="Right" Content="Dispatch" Padding="6,0" FontSize="11" Margin="4,0,0,0"
                                                            Command="{Binding DataContext.DispatchUnitCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding UnitId}" />
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Distance}" Width="56" TextAlignment="Right"
                                                               Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Eta}" Width="44" TextAlignment="Right"
                                                               FontFamily="Consolas" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                    <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                                        <Run Text="{Binding Callsign, Mode=OneWay}" FontWeight="SemiBold" />
                                                        <Run Text="{Binding Type, Mode=OneWay}" Foreground="{StaticResource MutedTextBrush}" />
                                                    </TextBlock>
                                                </DockPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="{Binding RankingNote}" FontSize="11" Foreground="{StaticResource MutedTextBrush}"
                                               TextWrapping="Wrap" Margin="0,0,0,12" />

                                    <TextBlock Text="ASSIGNED RESOURCES" Style="{StaticResource PanelHeader}" />
                                    <ItemsControl ItemsSource="{Binding Units}" Margin="0,0,0,12" />
                                    <TextBlock Text="REPORTS" Style="{StaticResource PanelHeader}" />
                                    <ItemsControl ItemsSource="{Binding Reports}" Margin="0,0,0,12">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,4" Foreground="{StaticResource MutedTextBrush}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="ZONES" Style="{StaticResource PanelHeader}" />
                                    <ItemsControl ItemsSource="{Binding Zones}" />
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </TabItem>
                    <TabItem Header="UNIT">
                        <Grid DataContext="{Binding UnitDetail}">
                            <TextBlock Style="{StaticResource EmptyHint}" Margin="4,8"
                                       Text="Click a unit on the map or in the resource board to see its live AVL data."
                                       Visibility="{Binding HasUnit, Converter={x:Static vm:Converters.FalseToVisible}}" />
                            <StackPanel Margin="4" Visibility="{Binding HasUnit, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{Binding Callsign}" FontSize="17" FontWeight="Bold" />
                                <TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding StatusText}" Style="{StaticResource UnitStatusText}" FontSize="15" Margin="0,6,0,10" />
                                <ItemsControl ItemsSource="{Binding Rows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:DetailRow}">
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="130" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Label}" Style="{StaticResource FieldLabel}" VerticalAlignment="Top" />
                                                <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Grid>
                    </TabItem>
                    <TabItem Header="ICS">
                        <Grid DataContext="{Binding Ics}">
                            <TextBlock Style="{StaticResource EmptyHint}" Margin="4,8"
                                       Text="Select an incident to build its command structure."
                                       Visibility="{Binding HasIncident, Converter={x:Static vm:Converters.FalseToVisible}}" />
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          Visibility="{Binding HasIncident, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel Margin="4">
                                    <TextBlock Text="POSITIONS" Style="{StaticResource PanelHeader}" />
                                    <ItemsControl ItemsSource="{Binding Positions}" Margin="0,0,0,12">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:PositionRow}">
                                                <DockPanel Margin="0,2">
                                                    <Button DockPanel.Dock="Right" Content="Assign" Padding="6,0" FontSize="11" Margin="4,0,0,0"
                                                            Command="{Binding AssignCommand}" />
                                                    <StackPanel DockPanel.Dock="Left" Width="128">
                                                        <TextBlock Text="{Binding Label}" />
                                                        <TextBlock Text="{Binding Staff}" FontSize="10" Foreground="{StaticResource MutedTextBrush}" />
                                                    </StackPanel>
                                                    <TextBox Text="{Binding NewHolder, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"
                                                             ToolTip="{Binding Holder, TargetNullValue='Vacant'}" />
                                                </DockPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock Text="SPAN OF CONTROL (recommended 3–7)" Style="{StaticResource PanelHeader}" />
                                    <ItemsControl ItemsSource="{Binding Spans}" Margin="0,0,0,12">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:SpanRow}">
                                                <DockPanel Margin="0,1">
                                                    <TextBlock x:Name="Rating" DockPanel.Dock="Right" Text="{Binding Rating}" Width="44" TextAlignment="Right"
                                                               FontWeight="SemiBold" Foreground="{StaticResource OkBrush}" />
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding DirectReports}" Width="30" TextAlignment="Right"
                                                               FontFamily="Consolas" />
                                                    <TextBlock Text="{Binding Supervisor}" TextTrimming="CharacterEllipsis" />
                                                </DockPanel>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding Rating}" Value="Over">
                                                        <Setter TargetName="Rating" Property="Foreground" Value="{StaticResource CriticalBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Rating}" Value="Under">
                                                        <Setter TargetName="Rating" Property="Foreground" Value="{StaticResource WarningBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Rating}" Value="Idle">
                                                        <Setter TargetName="Rating" Property="Foreground" Value="{StaticResource MutedTextBrush}" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock Text="GROUPS &amp; DIVISIONS (under Operations)" Style="{StaticResource PanelHeader}" />
                                    <ItemsControl ItemsSource="{Binding Groups}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:GroupRow}">
                                                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="3" Padding="8,6" Margin="0,0,0,6">
                                                    <StackPanel>
                                                        <DockPanel>
                                                            <Button DockPanel.Dock="Right" Content="Disband" Padding="6,0" FontSize="11" Margin="0"
                                                                    Command="{Binding DataContext.Ics.DisbandGroupCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding Id}" />
                                                            <TextBlock>
                                                                <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" />
                                                                <Run Text="{Binding Kind, Mode=OneWay}" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                                                            </TextBlock>
                                                        </DockPanel>
                                                        <TextBlock Text="{Binding Supervisor}" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                                                        <ItemsControl ItemsSource="{Binding Members}" ItemTemplate="{StaticResource UnitPlacementTemplate}" Margin="0,4,0,0" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,12">
                                        <ComboBox ItemsSource="{Binding GroupKinds}" SelectedItem="{Binding NewGroupKind}" Width="78" />
                                        <TextBox Text="{Binding NewGroupName, UpdateSourceTrigger=PropertyChanged}" Width="104" Margin="4,0,0,0"
                                                 ToolTip="Name, e.g. Fire Group, Medical Group, Division A" />
                                        <TextBox Text="{Binding NewGroupSupervisor, UpdateSourceTrigger=PropertyChanged}" Width="80" Margin="4,0,0,0"
                                                 ToolTip="Supervisor" />
                                        <Button Content="Form" Command="{Binding FormGroupCommand}" Padding="6,1" />
                                    </StackPanel>

                                    <TextBlock Text="REPORTING DIRECTLY TO COMMAND" Style="{StaticResource PanelHeader}" />
                                    <ItemsControl ItemsSource="{Binding Ungrouped}" ItemTemplate="{StaticResource UnitPlacementTemplate}" />
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>

        <GridSplitter Grid.Row="3" HorizontalAlignment="Stretch" Background="{StaticResource BorderBrush}"
                      ResizeDirection="Rows" ToolTip="Drag to resize" />

        <!-- ===== Bottom: status boards and history (Appendix D, §6.6) ===== -->
        <TabControl Grid.Row="4" Margin="0" Padding="0">
            <TabItem Header="STATUS BOARDS">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.05*" />
                        <ColumnDefinition Width="1.6*" />
                        <ColumnDefinition Width="1.2*" />
                    </Grid.ColumnDefinitions>

                    <!-- Incident status board -->
                    <Border Grid.Column="0" Style="{StaticResource Panel}" BorderThickness="0,0,1,0">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="INCIDENT STATUS" Style="{StaticResource PanelHeader}" />
                            <Grid>
                                <DataGrid ItemsSource="{Binding IncidentBoard}" SelectedItem="{Binding SelectedIncidentRow}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Incident" Binding="{Binding Number}" />
                                        <DataGridTextColumn Header="Type" Binding="{Binding Type}" />
                                        <DataGridTemplateColumn Header="Priority">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Priority}" Style="{StaticResource PriorityText}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" />
                                        <DataGridTextColumn Header="Cas. rep/conf" Binding="{Binding Casualties}" />
                                        <DataGridTextColumn Header="Units" Binding="{Binding Units}" />
                                        <DataGridTextColumn Header="IC" Binding="{Binding Commander}" />
                                        <DataGridTextColumn Header="Location" Binding="{Binding Location}" />
                                        <DataGridTextColumn Header="Updated" Binding="{Binding Updated}" />
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock Style="{StaticResource EmptyHint}" Margin="4,28,4,0" VerticalAlignment="Top"
                                           Text="No incidents. Open one from a call or report in the intelligence feed.">
                                    <TextBlock.Visibility>
                                        <Binding Path="IncidentBoard.Count" Converter="{x:Static vm:Converters.ZeroToVisible}" />
                                    </TextBlock.Visibility>
                                </TextBlock>
                            </Grid>
                        </DockPanel>
                    </Border>

                    <!-- Resource board -->
                    <Border Grid.Column="1" Style="{StaticResource Panel}" BorderThickness="0,0,1,0">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top">
                                <ItemsControl DockPanel.Dock="Right" ItemsSource="{Binding ResourceSummary}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:ResourceSummary}">
                                            <TextBlock FontSize="11" Foreground="{StaticResource MutedTextBrush}" Margin="10,0,0,0">
                                                <Run Text="{Binding Group, Mode=OneWay}" />
                                                <Run Text="{Binding Available, Mode=OneWay}" FontWeight="Bold" Foreground="{StaticResource TextBrush}" /><Run Text="/" /><Run Text="{Binding Total, Mode=OneWay}" />
                                            </TextBlock>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="RESOURCES" Style="{StaticResource PanelHeader}" />
                            </DockPanel>
                            <DataGrid ItemsSource="{Binding ResourceBoard}" SelectedItem="{Binding SelectedUnitRow}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Unit" Binding="{Binding Callsign}" />
                                    <DataGridTextColumn Header="Type" Binding="{Binding Type}" />
                                    <DataGridTemplateColumn Header="Status">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate DataType="{x:Type vm:UnitRow}">
                                                <TextBlock Text="{Binding StatusText}" Style="{StaticResource UnitStatusText}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Assignment" Binding="{Binding Assignment}" />
                                    <DataGridTextColumn Header="ETA" Binding="{Binding Eta}" />
                                    <DataGridTemplateColumn Header="Comms">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate DataType="{x:Type vm:UnitRow}">
                                                <TextBlock Text="{Binding Comms}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding CommsOk}" Value="False">
                                                                    <Setter Property="Foreground" Value="{StaticResource CriticalBrush}" />
                                                                    <Setter Property="FontWeight" Value="Bold" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Location" Binding="{Binding Location}" />
                                    <DataGridTextColumn Header="Crew" Binding="{Binding Crew}" />
                                    <DataGridTextColumn Header="Equipment" Binding="{Binding Equipment}" />
                                    <DataGridTextColumn Header="Last contact" Binding="{Binding LastContact}" />
                                    <DataGridTemplateColumn Header="Actions">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate DataType="{x:Type vm:UnitRow}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Content="Dispatch" Padding="6,0" FontSize="11"
                                                            ToolTip="Dispatch to the selected incident"
                                                            Visibility="{Binding CanDispatch, Converter={StaticResource BoolToVisibility}}"
                                                            Command="{Binding DataContext.DispatchUnitCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding Id}" />
                                                    <Button Content="Reassign" Padding="6,0" FontSize="11"
                                                            ToolTip="Move to the selected incident"
                                                            Visibility="{Binding CanReassign, Converter={StaticResource BoolToVisibility}}"
                                                            Command="{Binding DataContext.ReassignUnitCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding Id}" />
                                                    <Button Content="Stand down" Padding="6,0" FontSize="11"
                                                            Visibility="{Binding CanCancel, Converter={StaticResource BoolToVisibility}}"
                                                            Command="{Binding DataContext.CancelUnitCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding Id}" />
                                                    <ComboBox ItemsSource="{Binding NextStatuses}" SelectedItem="{Binding RequestedStatus}"
                                                              DisplayMemberPath="Label" Width="104" FontSize="11" Margin="4,0,0,0"
                                                              ToolTip="Record a status change reported by the unit" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>

                    <!-- Alerts and intelligence -->
                    <Border Grid.Column="2" Style="{StaticResource Panel}" BorderThickness="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="1.3*" />
                            </Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource PanelHeader}">
                                <Run Text="ALERTS" /><Run Text=" · " /><Run Text="{Binding UnacknowledgedAlerts, Mode=OneWay}" /><Run Text=" unacknowledged" />
                            </TextBlock>
                            <Grid Grid.Row="1">
                                <ListBox ItemsSource="{Binding AlertFeed}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:AlertRow}">
                                            <DockPanel Margin="0,0,0,6">
                                                <Button DockPanel.Dock="Right" Content="Ack" Padding="6,0" FontSize="11" VerticalAlignment="Top"
                                                        Visibility="{Binding Acknowledged, Converter={x:Static vm:Converters.FalseToVisible}}"
                                                        Command="{Binding DataContext.AcknowledgeAlertCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding Id}" />
                                                <TextBlock DockPanel.Dock="Left" Text="{Binding Time}" Width="40" FontFamily="Consolas"
                                                           Foreground="{StaticResource MutedTextBrush}" />
                                                <StackPanel>
                                                    <TextBlock x:Name="Title" TextWrapping="Wrap" FontWeight="SemiBold">
                                                        <Run Text="⚠" /> <Run Text="{Binding Title, Mode=OneWay}" />
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" />
                                                </StackPanel>
                                            </DockPanel>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding Severity}" Value="Critical">
                                                    <Setter TargetName="Title" Property="Foreground" Value="{StaticResource CriticalBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Severity}" Value="Warning">
                                                    <Setter TargetName="Title" Property="Foreground" Value="{StaticResource WarningBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Acknowledged}" Value="True">
                                                    <Setter TargetName="Title" Property="Foreground" Value="{StaticResource MutedTextBrush}" />
                                                    <Setter TargetName="Title" Property="FontWeight" Value="Normal" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock Style="{StaticResource EmptyHint}" Text="No alerts.">
                                    <TextBlock.Visibility>
                                        <Binding Path="AlertFeed.Count" Converter="{x:Static vm:Converters.ZeroToVisible}" />
                                    </TextBlock.Visibility>
                                </TextBlock>
                            </Grid>

                            <TextBlock Grid.Row="2" Text="INTELLIGENCE (calls and reports)" Style="{StaticResource PanelHeader}" Margin="0,8,0,4" />
                            <Grid Grid.Row="3">
                                <ListBox ItemsSource="{Binding IntelligenceFeed}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:ReportRow}">
                                            <DockPanel Margin="0,0,0,8">
                                                <TextBlock DockPanel.Dock="Left" Text="{Binding Time}" Width="40" FontFamily="Consolas"
                                                           Foreground="{StaticResource MutedTextBrush}" />
                                                <StackPanel>
                                                    <TextBlock TextWrapping="Wrap">
                                                        <Run Text="{Binding Source, Mode=OneWay}" FontWeight="SemiBold" />
                                                        <Run Text="·" Foreground="{StaticResource MutedTextBrush}" />
                                                        <Run Text="{Binding Incident, Mode=OneWay}" Foreground="{StaticResource MutedTextBrush}" />
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding Claim, StringFormat=“{0}”}" TextWrapping="Wrap" />
                                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                        <Border Style="{StaticResource Badge}">
                                                            <TextBlock Text="{Binding Confidence, StringFormat={}{0} confidence}" FontSize="10" />
                                                        </Border>
                                                        <Border Style="{StaticResource Badge}">
                                                            <TextBlock Text="{Binding Verification}" FontSize="10" />
                                                        </Border>
                                                        <Border Style="{StaticResource Badge}">
                                                            <TextBlock Text="{Binding Accuracy}" FontSize="10" />
                                                        </Border>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                        <ComboBox ItemsSource="{x:Static vm:ReportRow.Grades}" SelectedItem="{Binding RequestedVerification}"
                                                                  DisplayMemberPath="Label" Width="96" FontSize="11" ToolTip="Re-grade this report" />
                                                        <Button Content="Open incident" Padding="6,0" FontSize="11"
                                                                ToolTip="Create an incident at this report's location"
                                                                Visibility="{Binding IsUnattributed, Converter={StaticResource BoolToVisibility}}"
                                                                Command="{Binding DataContext.CreateIncidentFromReportCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding Id}" />
                                                        <Button Content="Link to selected" Padding="6,0" FontSize="11"
                                                                ToolTip="Attribute this report to the selected incident"
                                                                Visibility="{Binding CanLink, Converter={StaticResource BoolToVisibility}}"
                                                                Command="{Binding DataContext.LinkReportCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding Id}" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock Style="{StaticResource EmptyHint}" Text="No calls or reports yet.">
                                    <TextBlock.Visibility>
                                        <Binding Path="IntelligenceFeed.Count" Converter="{x:Static vm:Converters.ZeroToVisible}" />
                                    </TextBlock.Visibility>
                                </TextBlock>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <TextBlock>
                        <Run Text="COMMAND &amp; CONTROL" />
                        <Run Text="{Binding Command.PendingApprovals, Mode=OneWay, StringFormat=' · {0} awaiting decision'}" Foreground="{StaticResource WarningBrush}" />
                    </TextBlock>
                </TabItem.Header>
                <Grid DataContext="{Binding Command}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Orders -->
                    <Border Grid.Column="0" Style="{StaticResource Panel}" BorderThickness="0,0,1,0">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="ORDERS (selected incident)" Style="{StaticResource PanelHeader}" />
                            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                <ComboBox ItemsSource="{Binding OrderTargets}" SelectedItem="{Binding OrderTarget}" DisplayMemberPath="Label"
                                          ToolTip="Units, groups and staffed positions of the selected incident" />
                                <DockPanel Margin="0,4,0,0">
                                    <Button DockPanel.Dock="Right" Content="Issue" Command="{Binding IssueOrderCommand}" Margin="4,0,0,0" />
                                    <TextBox Text="{Binding OrderText, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="e.g. Set up exposure protection on unit 4" />
                                </DockPanel>
                            </StackPanel>
                            <ListBox ItemsSource="{Binding Orders}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:OrderRow}">
                                        <StackPanel Margin="0,0,0,8">
                                            <TextBlock TextWrapping="Wrap">
                                                <Run Text="{Binding Time, Mode=OneWay}" Foreground="{StaticResource MutedTextBrush}" />
                                                <Run Text="{Binding Target, Mode=OneWay}" FontWeight="SemiBold" />
                                                <Run Text="·" Foreground="{StaticResource MutedTextBrush}" />
                                                <Run x:Name="State" Text="{Binding Status, Mode=OneWay}" />
                                            </TextBlock>
                                            <TextBlock Text="{Binding Text, StringFormat=“{0}”}" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding ReadBack}" TextWrapping="Wrap" FontStyle="Italic"
                                                       Foreground="{StaticResource MutedTextBrush}" />
                                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0"
                                                        Visibility="{Binding IsOpen, Converter={StaticResource BoolToVisibility}}">
                                                <Button Content="Complete" Padding="6,0" FontSize="11" Margin="0,0,4,0"
                                                        Command="{Binding DataContext.Command.CompleteOrderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding Id}" />
                                                <Button Content="Cancel" Padding="6,0" FontSize="11"
                                                        Command="{Binding DataContext.Command.CancelOrderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding Id}" />
                                            </StackPanel>
                                        </StackPanel>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding AwaitingReadBack}" Value="True">
                                                <Setter TargetName="State" Property="Foreground" Value="{StaticResource WarningBrush}" />
                                                <Setter TargetName="State" Property="Text" Value="Awaiting read-back" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>

                    <!-- Resource requests -->
                    <Border Grid.Column="1" Style="{StaticResource Panel}" BorderThickness="0,0,1,0">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="RESOURCE REQUESTS (selected incident)" Style="{StaticResource PanelHeader}" />
                            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                <DockPanel>
                                    <TextBox DockPanel.Dock="Right" Text="{Binding RequestQuantity, UpdateSourceTrigger=PropertyChanged}" Width="36"
                                             Margin="4,0,0,0" ToolTip="Quantity" />
                                    <ComboBox DockPanel.Dock="Left" ItemsSource="{Binding RequestKinds}" SelectedItem="{Binding RequestKind}" Width="150" />
                                    <ComboBox ItemsSource="{Binding RequestableTypes}" SelectedItem="{Binding RequestType}" DisplayMemberPath="Label"
                                              Margin="4,0,0,0" />
                                </DockPanel>
                                <DockPanel Margin="0,4,0,0">
                                    <Button DockPanel.Dock="Right" Content="Request" Command="{Binding RequestResourcesCommand}" Margin="4,0,0,0" />
                                    <TextBox Text="{Binding RequestJustification, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="Justification (required for mutual aid and specialist teams)" />
                                </DockPanel>
                            </StackPanel>
                            <ListBox ItemsSource="{Binding Requests}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:RequestRow}">
                                        <StackPanel Margin="0,0,0,8">
                                            <TextBlock TextWrapping="Wrap">
                                                <Run Text="{Binding Time, Mode=OneWay}" Foreground="{StaticResource MutedTextBrush}" />
                                                <Run x:Name="State" Text="{Binding Status, Mode=OneWay}" FontWeight="SemiBold" />
                                            </TextBlock>
                                            <TextBlock Text="{Binding Description}" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" />
                                        </StackPanel>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Status}" Value="Denied">
                                                <Setter TargetName="State" Property="Foreground" Value="{StaticResource CriticalBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="Approved">
                                                <Setter TargetName="State" Property="Foreground" Value="{StaticResource OkBrush}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>

                    <!-- Approvals -->
                    <Border Grid.Column="2" Style="{StaticResource Panel}" BorderThickness="0,0,1,0">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="APPROVALS (decisions for command)" Style="{StaticResource PanelHeader}" />
                            <TextBox DockPanel.Dock="Top" Text="{Binding DecisionNote, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"
                                     ToolTip="Optional note sent with your decision" />
                            <Grid>
                                <ListBox ItemsSource="{Binding Approvals}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:ApprovalRow}">
                                            <StackPanel Margin="0,0,0,10">
                                                <TextBlock TextWrapping="Wrap">
                                                    <Run Text="{Binding Time, Mode=OneWay}" Foreground="{StaticResource MutedTextBrush}" />
                                                    <Run x:Name="Subject" Text="{Binding Subject, Mode=OneWay}" FontWeight="SemiBold" />
                                                </TextBlock>
                                                <TextBlock Text="{Binding RequestedBy}" Foreground="{StaticResource MutedTextBrush}" />
                                                <TextBlock Text="{Binding Details}" TextWrapping="Wrap" />
                                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0"
                                                            Visibility="{Binding IsPending, Converter={StaticResource BoolToVisibility}}">
                                                    <Button Content="Approve" Padding="8,1" FontSize="11" Margin="0,0,4,0"
                                                            Command="{Binding DataContext.Command.ApproveCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding Id}" />
                                                    <Button Content="Deny" Padding="8,1" FontSize="11"
                                                            Command="{Binding DataContext.Command.DenyCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding Id}" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding Status}" Foreground="{StaticResource MutedTextBrush}"
                                                           Visibility="{Binding IsPending, Converter={x:Static vm:Converters.FalseToVisible}}" />
                                            </StackPanel>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsPending}" Value="True">
                                                    <Setter TargetName="Subject" Property="Foreground" Value="{StaticResource WarningBrush}" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock Style="{StaticResource EmptyHint}" Text="Nothing is waiting for a decision.">
                                    <TextBlock.Visibility>
                                        <Binding Path="Approvals.Count" Converter="{x:Static vm:Converters.ZeroToVisible}" />
                                    </TextBlock.Visibility>
                                </TextBlock>
                            </Grid>
                        </DockPanel>
                    </Border>

                    <!-- Notifications -->
                    <Border Grid.Column="3" Style="{StaticResource Panel}" BorderThickness="0">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="NOTIFICATIONS (outside organisations)" Style="{StaticResource PanelHeader}" />
                            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                <ComboBox ItemsSource="{Binding Recipients}" Text="{Binding Recipient, UpdateSourceTrigger=PropertyChanged}"
                                          IsEditable="True" ToolTip="Pick or type a recipient" />
                                <DockPanel Margin="0,4,0,0">
                                    <Button DockPanel.Dock="Right" Content="Send" Command="{Binding NotifyCommand}" Margin="4,0,0,0" />
                                    <TextBox Text="{Binding NotificationText, UpdateSourceTrigger=PropertyChanged}" />
                                </DockPanel>
                            </StackPanel>
                            <ListBox ItemsSource="{Binding Notifications}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:NotificationRow}">
                                        <StackPanel Margin="0,0,0,8">
                                            <TextBlock>
                                                <Run Text="{Binding Time, Mode=OneWay}" Foreground="{StaticResource MutedTextBrush}" />
                                                <Run Text="{Binding Recipient, Mode=OneWay}" FontWeight="SemiBold" />
                                            </TextBlock>
                                            <TextBlock Text="{Binding Message, StringFormat=“{0}”}" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Reply}" TextWrapping="Wrap" FontStyle="Italic"
                                                       Foreground="{StaticResource MutedTextBrush}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="HISTORY &amp; REPLAY">
                <DockPanel DataContext="{Binding Timeline}" Margin="12,8">
                    <!-- Replay control -->
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="Show COP at this time" Command="{Binding ReplayCommand}" />
                            <Button Content="Live" Command="{Binding ReturnToLiveCommand}" />
                        </StackPanel>
                        <TextBlock DockPanel.Dock="Left" Text="REPLAY" Style="{StaticResource PanelHeader}" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <TextBlock DockPanel.Dock="Left" Text="{Binding SliderLabel}" FontFamily="Consolas" VerticalAlignment="Center"
                                   Width="70" />
                        <Slider Minimum="0" Maximum="{Binding MaxSeconds}" Value="{Binding ReplaySeconds}" VerticalAlignment="Center"
                                Margin="8,0" ToolTip="Drag to a moment in the session, then 'Show COP at this time'" />
                    </DockPanel>

                    <!-- Filters -->
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="HISTORY LOG" Style="{StaticResource PanelHeader}" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <ComboBox ItemsSource="{Binding Filters}" SelectedItem="{Binding SelectedFilter}" Width="170" />
                        <CheckBox Content="Key events only" IsChecked="{Binding ImportantOnly}" Margin="12,0,0,0" VerticalAlignment="Center" />
                        <CheckBox Content="Show ground truth (instructor / AAR)" IsChecked="{Binding ShowTruth}" Margin="12,0,0,0"
                                  VerticalAlignment="Center" />
                        <TextBlock Text="Double-click a line to see the COP at that moment." Margin="16,0,0,0" VerticalAlignment="Center"
                                   Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                    </StackPanel>

                    <ListBox ItemsSource="{Binding Entries}" FontFamily="Consolas" FontSize="12"
                             MouseDoubleClick="TimelineList_MouseDoubleClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:TimelineRow}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="200" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Time}" Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBlock x:Name="Category" Grid.Column="1" Text="{Binding Category}" />
                                    <TextBlock x:Name="Text" Grid.Column="2" Text="{Binding Text}" TextWrapping="Wrap" />
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Important}" Value="True">
                                        <Setter TargetName="Category" Property="Foreground" Value="{StaticResource WarningBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsTruth}" Value="True">
                                        <Setter TargetName="Category" Property="Foreground" Value="#C792EA" />
                                        <Setter TargetName="Text" Property="Foreground" Value="#C792EA" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
